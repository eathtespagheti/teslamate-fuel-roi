# Database (points at your TeslaMate Postgres)
PGHOST=teslamate-db
PGPORT=5432
PGUSER=teslamate
# set this to your database password (empty only if your DB uses trust auth):
PGPASSWORD=
PGDATABASE=teslamate
# Optional tuning
MASE_URL=https://sisen.mase.gov.it/dgsaie/api/v1/weekly-prices/report/export?format=JSON&lang=it
MIN_ROWS=1000
MAX_AGE_DAYS=14
