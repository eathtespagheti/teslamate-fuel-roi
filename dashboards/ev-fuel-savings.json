      "targets": [
        {
          "format": "table",
          "rawSql": "WITH weekly_fuel AS (SELECT date_trunc('week', d.start_date) AS period_start, SUM((ep.odometer - sp.odometer) / NULLIF($consumption_km_l,0) * fp.price) AS fuel_cost FROM drives d JOIN positions sp ON sp.id=d.start_position_id JOIN positions ep ON ep.id=d.end_position_id LEFT JOIN LATERAL (SELECT CASE '$fuel_type' WHEN 'benzina' THEN benzina WHEN 'gasolio_auto' THEN gasolio_auto WHEN 'gpl' THEN gpl WHEN 'metano' THEN metano WHEN 'gnl' THEN gnl WHEN 'gasolio_riscaldamento' THEN gasolio_riscaldamento WHEN 'oc_fluido_btz' THEN oc_fluido_btz WHEN 'oc_denso_btz' THEN oc_denso_btz ELSE gasolio_auto END AS price FROM fuel.prices WHERE rilevazione <= d.start_date::date ORDER BY rilevazione DESC LIMIT 1) fp ON true WHERE d.car_id IN ($car_id) AND $__timeFilter(d.start_date) AND d.end_date IS NOT NULL GROUP BY 1), weekly_electricity AS (SELECT date_trunc('week', start_date) AS period_start, SUM(cost) AS electricity_cost FROM charging_processes WHERE car_id IN ($car_id) AND $__timeFilter(start_date) AND cost IS NOT NULL GROUP BY 1), weekly_savings AS (SELECT COALESCE(d.period_start,e.period_start) AS period_start, COALESCE(d.fuel_cost,0) AS fuel_cost, COALESCE(e.electricity_cost,0) AS electricity_cost FROM weekly_fuel d FULL OUTER JOIN weekly_electricity e USING(period_start)) SELECT period_start AS time, fuel_cost AS \"Fuel cost avoided (€)\", electricity_cost AS \"Electricity (€)\", fuel_cost-electricity_cost AS \"Savings this week (€)\", SUM(fuel_cost-electricity_cost) OVER(ORDER BY period_start) AS \"Cumulative net savings (€)\" FROM weekly_savings ORDER BY period_start",
          "refId": "A"
        }
      ],
      "title": "Weekly gross and net savings",
      "type": "timeseries"
    },
