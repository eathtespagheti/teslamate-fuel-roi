        {
          "format": "table",
          "rawSql": "SELECT COALESCE(SUM((ep.odometer - sp.odometer) / NULLIF($consumption_km_l,0) * fp.price),0) AS value FROM drives d JOIN positions sp ON sp.id=d.start_position_id JOIN positions ep ON ep.id=d.end_position_id LEFT JOIN LATERAL (SELECT CASE '$fuel_type' WHEN 'benzina' THEN benzina WHEN 'gasolio_auto' THEN gasolio_auto WHEN 'gpl' THEN gpl WHEN 'metano' THEN metano WHEN 'gnl' THEN gnl WHEN 'gasolio_riscaldamento' THEN gasolio_riscaldamento WHEN 'oc_fluido_btz' THEN oc_fluido_btz WHEN 'oc_denso_btz' THEN oc_denso_btz ELSE gasolio_auto END AS price FROM fuel.prices WHERE rilevazione <= d.start_date::date ORDER BY rilevazione DESC LIMIT 1) fp ON true WHERE d.car_id IN ($car_id) AND $__timeFilter(d.start_date) AND d.end_date IS NOT NULL",
          "refId": "A"
        }
      ],
